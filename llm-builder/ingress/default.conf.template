# Templated at container start (envsubst). Public listen port = RAGLINE_API_PORT (browser-facing).
server {
    listen ${RAGLINE_API_PORT};
    server_name _;

    client_max_body_size 100m;

    location /v1/ {
        proxy_pass http://${VLLM_PROXY_HOST}:${VLLM_PROXY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /hosted/ {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location = /health {
        proxy_pass http://app:8000/health;
        proxy_set_header Host $host;
    }

    location = /ready {
        proxy_pass http://app:8000/ready;
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass http://app:8000/openapi.json;
        proxy_set_header Host $host;
    }

    location = / {
        proxy_pass http://app:8000/;
        proxy_set_header Host $host;
    }
}
