SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

QDRANT_API_KEY=

# Host ports. Browser uses same hostname + RAGLINE_API_PORT (ingress: /api/ → RAGLine, /v1/ → vLLM).
RAGLINE_UI_PORT=3000
RAGLINE_API_PORT=8005
# Optional: where ingress proxies /v1/ (defaults match Host Models on host port 8010).
# VLLM_PROXY_HOST=host.docker.internal
# VLLM_PROXY_PORT=8010

# Optional: only if UI is on port 80/443, or you need extra origins (comma-separated).
CORS_ALLOW_ORIGINS=

# --- Host Models (vLLM from local model dirs on the Docker host; bundled docker CLI in the app image) ---
# Base URL clients use for vLLM (scheme + host + public ingress port).
# HOST_MODELS_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8005
# Optional: HF hub cache bind-mount for vLLM (absolute host path). Weights are always a local directory in the UI.
# HOST_MODELS_HF_CACHE_DIR=/data/hf-cache
# Optional: restrict model paths to this absolute host prefix.
# HOST_MODELS_LOCAL_PATH_PREFIX=/data/models
# Optional: override docker binary inside the API container (default: docker → /usr/bin/docker from image).
# HOST_MODELS_DOCKER_CMD=docker
# Optional: vLLM OpenAI-compatible image for host-model containers.
# HOST_MODELS_VLLM_IMAGE=vllm/vllm-openai:latest
# Optional: max seconds to poll vLLM /health after docker run (default 900). Large models may need more.
# HOST_MODELS_HEALTH_TIMEOUT_SECONDS=1800
# Optional: base URL for /health probes only when API is in Docker (default uses host.docker.internal).
# HOST_MODELS_HEALTH_PROBE_BASE_URL=http://172.17.0.1
