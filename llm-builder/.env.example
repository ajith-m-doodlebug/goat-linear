# Backend
DATABASE_URL=postgresql://llmbuilder:llmbuilder@postgres:5432/llmbuilder
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Qdrant (Phase 2+)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Frontend (for server-side API base URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: default Ollama URL when a model has no endpoint_url. In Docker with Ollama on host use:
# OLLAMA_DEFAULT_URL=http://host.docker.internal:11434

# Optional: SMTP for OTP emails (user registration). If unset, registration will fail with "Email not configured".
# When using Docker Compose, Postfix is included: app uses SMTP_HOST=postfix, SMTP_PORT=587 (set in docker-compose.yml).
# To use Postfix with an external relay (e.g. Gmail), set in docker-compose.yml under postfix service:
#   RELAYHOST: smtp.gmail.com:587
#   RELAYHOST_USERNAME: your@gmail.com
#   RELAYHOST_PASSWORD: app-password
#   RELAYHOST_TLS_LEVEL: may
# To use a different SMTP provider instead of Postfix, override in .env:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_USE_TLS=true

# Optional: external LLM (Phase 3+)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
