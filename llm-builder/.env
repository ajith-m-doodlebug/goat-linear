# Backend
DATABASE_URL=postgresql://llmbuilder:llmbuilder@postgres:5432/llmbuilder
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Qdrant (Phase 2+)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Docker Compose: published host ports (defaults: UI 3000, API 8000)
# RAGLINE_UI_PORT=3000
# RAGLINE_API_PORT=8000

# Frontend: omit NEXT_PUBLIC_API_URL to use http://localhost:<RAGLINE_API_PORT>; set explicitly for a public API URL.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: default Ollama URL when a model has no endpoint_url. In Docker with Ollama on host use:
# OLLAMA_DEFAULT_URL=http://host.docker.internal:11434

# Optional: SMTP for OTP emails (user registration). Docker Compose sets SMTP_HOST=postfix; override here if using another provider.
# SMTP_HOST=postfix
# SMTP_PORT=587
# SMTP_FROM_EMAIL=noreply@localhost
# SMTP_USE_TLS=false

# Optional: external LLM (Phase 3+)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
